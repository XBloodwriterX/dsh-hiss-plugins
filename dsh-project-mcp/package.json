{
  "name": "@hilariouhiss/dsh-project-mcp",
  "version": "1.0.2",
  "description": "Load the project's .mcp.json MCP servers into DeepSeek Harness, scoped to the session that opened there.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "mcp",
    "mcp-json"
  ],
  "license": "MIT",
  "author": {
    "name": "dsh-project-mcp contributors"
  },
  "homepage": "https://github.com/hilariouhiss/dsh-hiss-plugins/tree/main/dsh-project-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hilariouhiss/dsh-hiss-plugins.git",
    "directory": "dsh-project-mcp"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-mcp-client": "^0.2.1-alpha.4"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-mcp-client": "0.2.1-alpha.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=20"
  }
